APP_NAME=Boilerplate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Em produção use LOG_STACK=json: uma linha JSON por evento no stdout, que é
# o que um coletor lê sem regex. O formato legível fica para o desenvolvimento.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Serviços
#
# Os valores abaixo apontam para 127.0.0.1, servindo Herd e execução nativa.
# No Sail, o compose.yaml sobrescreve esses hosts pelos nomes dos containers.
# ---------------------------------------------------------------------------

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# URL chamada a cada execução bem-sucedida do agendador. Vazio desliga.
# Um cron que parou não emite erro; quem avisa é o serviço do outro lado.
SCHEDULER_HEARTBEAT_URL=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO (S3 compatível). Console: http://localhost:8900 (sail / password)
# As credenciais DB_* são as do container Postgres do Sail.
AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=local
AWS_ENDPOINT=http://localhost:9000
AWS_URL=http://localhost:9000/local
AWS_USE_PATH_STYLE_ENDPOINT=true

# Login social. Deixe em branco para desabilitar o provedor: sem client_id o
# botão não aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# VirtualPay (gateway Pix nacional). Rotacione qualquer credencial que já tenha vazado.
# Em dev local, VIRTUALPAY_API_URL costuma apontar para o gateway-virtual local
# (ex.: http://localhost:PORT/api/v2), não para o endpoint de produção abaixo.
VIRTUALPAY_API_URL=https://api.virtualpay.online/v2
VIRTUALPAY_CLIENT_ID=
VIRTUALPAY_CLIENT_SECRET=
# Precisa ser IGUAL ao "secret" cadastrado no webhook do merchant no gateway
# (Filament ou tinker do gateway-virtual) — ele é digitado manualmente lá, não
# tem API para buscar de volta. Trocar localmente: php artisan virtualpay:webhook-secret <valor>
VIRTUALPAY_WEBHOOK_SECRET=
VIRTUALPAY_INTEGRATION=false

# Dias de teste sem cartão. Zero desliga.
BILLING_TRIAL_DAYS=14

# Disco dos avatares. O padrão s3 aponta para o MinIO acima.
AVATAR_DISK=s3

# Dias de retenção antes da remoção definitiva de uma conta excluída.
ACCOUNT_PURGE_AFTER_DAYS=30

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=
MEILISEARCH_NO_ANALYTICS=true

VITE_APP_NAME="${APP_NAME}"

# UID/GID do host para o container do Sail
WWWUSER=1000
WWWGROUP=1000

# Reverb (WebSockets). Sem VITE_REVERB_APP_KEY o cliente não tenta conectar.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Observabilidade
# O Sentry fica inerte sem DSN, então em local pode continuar vazio.
SENTRY_LARAVEL_DSN=
# Amostra de traces: 1.0 registra tudo e fica caro em produção. O padrão do
# pacote é não amostrar nada, o que deixa o desempenho invisível.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Sem release, todo erro aparece como se fosse da mesma versão e não dá para
# ver que um deploy introduziu a regressão. No deploy, exporte o SHA do commit.
SENTRY_RELEASE=
