{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "padrinho/boilerplate-laravel",
    "type": "project",
    "description": "Boilerplate Laravel modular para SaaS multi-tenant.",
    "keywords": [
        "laravel",
        "boilerplate",
        "saas",
        "multi-tenant",
        "livewire",
        "filament"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "dedoc/scramble": "^0.13.36",
        "filament/filament": "^5.0",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/horizon": "^5.48",
        "laravel/pennant": "^1.24",
        "laravel/pulse": "^1.7",
        "laravel/reverb": "^1.11",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.29",
        "laravel/tinker": "^3.0",
        "livewire/blaze": "^1.0",
        "livewire/flux": "^2.13.1",
        "livewire/livewire": "^4.1",
        "sentry/sentry-laravel": "^4.27",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-query-builder": "^7.3"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "laravel/telescope": "^5.21",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "peckphp/peck": "^0.3.0",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-drift": "^4.1",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "rector/rector": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "@php artisan filament:assets",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "refactor": [
            "rector"
        ],
        "refactor:check": [
            "rector --dry-run"
        ],
        "types:check": [
            "phpstan analyse --memory-limit=1G"
        ],
        "types:coverage": [
            "@php -d memory_limit=1G vendor/bin/pest --type-coverage --min=99"
        ],
        "spell:check": [
            "peck"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test --exclude-testsuite=Browser"
        ],
        "test:browser": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php artisan test --testsuite=Browser"
        ],
        "test:coverage": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php -d memory_limit=1G vendor/bin/pest --exclude-testsuite=Browser --coverage --min=85"
        ],
        "test:mutate": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=2G vendor/bin/pest --exclude-testsuite=Browser --mutate --covered-only --min=95 --class='App\\Support\\TenantManager,App\\Models\\Scopes\\TenantScope,App\\Concerns\\BelongsToTenant,App\\Jobs\\Concerns\\TenantAware,App\\Support\\Billing,App\\Support\\Billing\\Subscriptions,App\\Support\\Billing\\Franquia,App\\Actions\\Billing\\ActivatePlan,App\\Actions\\Billing\\PurchasePlan,App\\Policies,App\\Support\\Impersonation,App\\Http\\Middleware\\EnsureTeamMembership,App\\Http\\Middleware\\EnsureTeamIsNotSuspended,App\\Http\\Middleware\\EnsureTokenAbility,App\\Http\\Middleware\\SetTenantFromToken,App\\Http\\Middleware\\EnsurePlanFeature,App\\Actions\\Teams\\InviteTeamMember,App\\Actions\\Teams\\ImportInvitations,Modules\\Wallet\\Actions\\ReserveCredit,Modules\\Wallet\\Actions\\ConfirmHold,Modules\\Wallet\\Actions\\ReleaseHold,Modules\\Wallet\\Actions\\CreditWallet,Modules\\Wallet\\Models\\Wallet,App\\Actions\\CheckerApi\\ExecutarCheck,Modules\\Payments\\Webhooks\\VirtualPayWebhookVerifier,Modules\\Payments\\Actions\\CreateRecharge,App\\Http\\Controllers\\VirtualPayWebhookController'"
        ],
        "check": [
            "Composer\\Config::disableProcessTimeout",
            "@lint:check",
            "@refactor:check",
            "@types:check",
            "@spell:check",
            "@test",
            "@types:coverage"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
